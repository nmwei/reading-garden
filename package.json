{
  "name": "reading-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An illustrated Chinese reading garden for iPad.",
  "scripts": {
    "dev": "node scripts/build.mjs && node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:storyweaver": "node scripts/import-storyweaver.mjs",
    "assets:pinyin": "node scripts/import-pinyin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "deploy": "node scripts/publish.mjs --repository nmwei/reading-garden"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
