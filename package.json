{
  "name": "reading-garden",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An illustrated Chinese reading garden for iPad.",
  "scripts": {
    "dev": "node ../garden-platform/scripts/develop.mjs --site reading",
    "build": "node scripts/build.mjs",
    "assets:import": "node scripts/import-assets.mjs",
    "assets:storyweaver": "node scripts/import-storyweaver.mjs",
    "assets:pinyin": "node scripts/import-pinyin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm test && npm run build && npm run test:e2e",
    "deploy": "node scripts/publish.mjs",
    "pretest": "node scripts/prepare-account.mjs",
    "build:domain": "node scripts/build-domain.mjs",
    "dev:gardens": "node ../garden-platform/scripts/develop.mjs",
    "build:gardens": "node ../garden-platform/scripts/build-gardens.mjs",
    "test:server": "node ../garden-platform/scripts/test-server.mjs",
    "package:server": "node ../garden-platform/scripts/package-server.mjs",
    "test:domain": "npm run build:domain && node --test server/tests/*.test.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@garden/account": "file:../garden-platform/packages/account"
  }
}
